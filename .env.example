# Transport
SAP_TRANSPORT=stdio          # stdio | http
SAP_HTTP_PORT=8080
SAP_HTTP_AUTH_TOKEN=
SAP_LOG_LEVEL=info

# Which connectors to enable (comma-separated)
SAP_ENABLED_CONNECTORS=rfc,sac,adt

# RFC (requires SAP NWRFC SDK + node-rfc native module; see README)
SAP_RFC_ASHOST=
SAP_RFC_SYSNR=00
SAP_RFC_CLIENT=100
SAP_RFC_USER=
SAP_RFC_PASSWD=
SAP_RFC_LANG=EN
# RFC SNC (Secure Network Communications) — passwordless SSO over TLS.
# Set SNC_MODE=1 to enable. USER/PASSWD may be omitted (SNC authenticates).
SAP_RFC_SNC_MODE=0
SAP_RFC_SNC_PARTNER_NAME=
SAP_RFC_SNC_QOP=
SAP_RFC_SNC_MYNAME=
SAP_RFC_SNC_LIB=

# SAP Analytics Cloud
SAP_SAC_URL=
SAP_SAC_TOKEN=

# ABAP Development Tools  (authMode: basic | xsuaa | jwt | sso)
SAP_ADT_BASEURL=
SAP_ADT_AUTHMODE=basic
# Read-only mode: blocks write operations (write_source, activate, delete, transports, etc.)
SAP_ADT_READONLY=false
SAP_ADT_USER=
SAP_ADT_PASS=
# BTP ABAP Environment (xsuaa):
SAP_ADT_CLIENTID=
SAP_ADT_CLIENTSECRET=
SAP_ADT_TOKENURL=
SAP_ADT_TENANT=
# JWT mode - pre-provided token (from mcp-auth CLI or external source):
SAP_ADT_TOKEN=
# JWT mode - browser SSO (opens browser for login):
SAP_ADT_UAA_URL=
SAP_ADT_UAA_CLIENT_ID=
SAP_ADT_UAA_CLIENT_SECRET=
SAP_ADT_AUTH_BROKER_PORT=61001

# ── SSO mode (authMode=sso) ──────────────────────────────────────────────
# The SSO flavour. One of:
#   client_credentials | saml2_pure | token |
#   sso2 (MYSAPSSO2) | spnego (Kerberos)
# Comma-separated list = automatic fallback: candidates are tried in order
# on startup (first valid one wins); on repeated renewal failure the
# connector switches to the next candidate. Example:
#   SAP_ADT_SSO_TYPE=spnego,sso2,client_credentials
SAP_ADT_SSO_TYPE=spnego,sso2,client_credentials
# Interaction for saml2_pure: browser | manual | external (default browser)
SAP_ADT_STRATEGY=browser
# OAuth2 / SAML endpoints
SAP_ADT_ISSUER_URL=
SAP_ADT_AUTHORIZATION_ENDPOINT=
SAP_ADT_TOKEN_ENDPOINT=
SAP_ADT_CLIENT_ID=
SAP_ADT_CLIENT_SECRET=
# SAML 2.0 (saml2_pure)
SAP_ADT_SAML_TRUST=
# UAA / XSUAA (client_credentials)
SAP_ADT_UAA_URL=
# MYSAPSSO2 (sso2) — system PSE certificate + DSA private key (PEM or path)
SAP_ADT_PSE_CERT=
SAP_ADT_PSE_KEY=
SAP_ADT_SSO_USER=
SAP_ADT_SSO_CLIENT=
SAP_ADT_SSO_SYSTEM=
SAP_ADT_SSO_DURATION_HOURS=8
SAP_ADT_SSO_CODEPAGE=4103
# SPNEGO / Kerberos
SAP_ADT_KERBEROS_SERVICE=
SAP_ADT_KERBEROS_REALM=
# Automatic TGT acquisition (keytab mode): the connector runs
# `kinit -kt <keytab> <principal>` on startup and every 7h — no manual kinit.
# Omit both on Windows domain service accounts (LSA manages the TGT).
SAP_ADT_KERBEROS_KEYTAB=
SAP_ADT_KERBEROS_PRINCIPAL=
# Pre-provisioned token (type=token) / external strategy code
SAP_ADT_ACCESS_TOKEN=

# SAP GUI (Windows-only; requires winax + a running SAP GUI session)
# 免密 SSO: sap.gui.connect_existing attaches to an already-logged-on session.
# sap.gui.connect opens a new logon screen; credentials come only from here.
SAP_GUI_USER=
SAP_GUI_PASSWORD=
SAP_GUI_CLIENT=
SAP_GUI_LANGUAGE=

# Audit log: append-only JSONL of write operations (optional)
# MCP_AUDIT_FILE=./audit.jsonl
